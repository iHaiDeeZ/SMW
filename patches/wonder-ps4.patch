+        if (!len || i + len > in.size()) return false;
+        if (op == OpExtInstImport && len >= 3 &&
+            std::strcmp(reinterpret_cast<const char*>(&in[i + 2]), "GLSL.std.450") == 0)
+            glsl = in[i + 1];
+        if (op == OpTypeFloat && len == 3 && in[i + 2] == 32) f32 = in[i + 1];
