+// ---- audio: sceAudioOut, s16 stereo 48 kHz, fed from the queue of submitted buffers ----------------------------
+
+static void* audio_thread(void*) {
+    set_thread_name("SMW AudioOut");
+    // above the game's threads, so a slow frame does not make the sound crackle (default priority 700)
+    ps4_set_prio(ps4_pthread_self(), 400);
+    alignas(64) static int16_t grains[2][kGrainFrames * 2];
+    int current = 0;
+    std::vector<void*> finished;
+    for (;;) {
+        uint8_t* buf = reinterpret_cast<uint8_t*>(grains[current]);
+        const size_t n = sizeof grains[0];
+        size_t filled = 0;
+        finished.clear();
+        if (!g_audio_paused) {
+            std::lock_guard lk(g_audio);
+            while (filled < n && !g_pending.empty()) {
+                Pending& p = g_pending.front();
+                size_t take = std::min(n - filled, p.size - p.pos);
+                std::memcpy(buf + filled, p.data + p.pos, take);
+                filled += take;
+                p.pos += take;
+                if (p.pos == p.size) {
+                    finished.push_back(p.ctx);
+                    g_pending.pop_front();
+                }
+            }
+        }
+        if (filled < n) std::memset(buf + filled, 0, n - filled);  // underrun or paused: silence
+        for (void* ctx : finished) g_done(ctx);
+        sceAudioOutOutput(g_audio_port, buf);  // blocks until the previous grain plays
+        current ^= 1;
+    }
+    return nullptr;
+}
+
+bool audio_open(AudioDone done) {
+    g_done = done;
+    if (std::getenv("NX_MUTE")) return false;
+    int32_t r = sceAudioOutInit();
+    if (r != 0 && r != int32_t(0x8026000E)) {  // already initialized is fine
+        log("audio: sceAudioOutInit failed: %08x", unsigned(r));
+        return false;
+    }
+    g_audio_port = sceAudioOutOpen(0xFF, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, 48000,
+                                   ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (g_audio_port < 0) {
+        log("audio: sceAudioOutOpen failed: %08x", unsigned(g_audio_port));
+        return false;
+    }
+    int32_t volume[2] = {32768, 32768};  // 0 dB
+    sceAudioOutSetVolume(g_audio_port, 0x3, volume);
+    pthread_t t;
+    pthread_create(&t, nullptr, audio_thread, nullptr);
+    pthread_detach(t);
+    log("audio: sceAudioOut port %08x, %d frames at 48 kHz", unsigned(g_audio_port), kGrainFrames);
+    return true;
+}
+
+bool audio_submit(const void* data, size_t bytes, void* ctx) {
+    if (g_audio_port < 0) return false;
+    std::lock_guard lk(g_audio);
+    g_pending.push_back({static_cast<const uint8_t*>(data), bytes, 0, ctx});
+    return true;
+}
+
+uint32_t audio_queued() {
+    std::lock_guard lk(g_audio);
+    return uint32_t(g_pending.size());
+}
+
+void audio_pause(bool paused) { g_audio_paused = paused; }
+
+// ---- Vulkan: RADV linked in, with the VideoOut surface (ps4/ps4_vk_wsi.cpp) ------------------------------------
+
+void* vulkan_get_instance_proc_addr() { return ps4::vk_get_instance_proc_addr(); }
+const char* vulkan_surface_extension() { return VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME; }
+
+int vulkan_create_surface(void* instance, void*, uint64_t* surface, void* gipa) {
+    auto get = reinterpret_cast<PFN_vkGetInstanceProcAddr>(gipa ? gipa : ps4::vk_get_instance_proc_addr());
+    auto create = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(
+        get(static_cast<VkInstance>(instance), "vkCreateHeadlessSurfaceEXT"));
+    VkHeadlessSurfaceCreateInfoEXT ci{VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT};
+    VkSurfaceKHR s = VK_NULL_HANDLE;
+    VkResult r = create ? create(static_cast<VkInstance>(instance), &ci, nullptr, &s) : VK_ERROR_EXTENSION_NOT_PRESENT;
+    *surface = reinterpret_cast<uint64_t>(s);
+    return r;
+}
+
+}  // namespace nx::plat
+
+// ---- fault handler, crash report and entry --------------------------------------------------------------------
+
+namespace {
+
+struct sigaction g_old_segv, g_old_bus;
+
+void chain(int sig, siginfo_t* info, void* uc) {
+    struct sigaction& old = sig == SIGBUS ? g_old_bus : g_old_segv;
+    if (old.sa_flags & SA_SIGINFO) {
+        old.sa_sigaction(sig, info, uc);
+        return;
+    }
+    if (old.sa_handler == SIG_IGN) return;
+    if (old.sa_handler != SIG_DFL) {
+        old.sa_handler(sig);
+        return;
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+void fault_handler(int sig, siginfo_t* info, void* uc) {
+    if (nx::plat::write_watch_fault(info->si_addr)) return;               // write_watch.cpp
+    if (nx::plat::lazy::fault(uint64_t(uintptr_t(info->si_addr)))) return;  // first touch of guest memory
+    chain(sig, info, uc);  // port/ps4_crashlog.cpp writes crash.log (and calls ps4_crash_guest_info)
+}
+
+void install_fault_handler() {
+    struct sigaction sa;
+    std::memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = fault_handler;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, &g_old_segv);
+    sigaction(SIGBUS, &sa, &g_old_bus);
+}
+
+void load_system_modules() {
+    // Calling into a system library whose module isn't loaded ends the app without a word.
+    const std::pair<const char*, uint32_t> modules[] = {
+        {"SystemService", 0x80000010}, {"UserService", 0x80000011}, {"VideoOut", 0x80000022},
+        {"AudioOut", 0x80000001},      {"Pad", 0x80000024},
+    };
+    for (const auto& [name, id] : modules) {
+        int r = int(sceSysmoduleLoadModuleInternal(OrbisSysModuleInternal(id)));
+        if (r != 0) nx::plat::trace("loading system module %s failed (%x)", name, unsigned(r));
+    }
+}
+
+std::string app_version() {
+    char buf[32]{};
+    if (FILE* f = std::fopen("/app0/version.txt", "r")) {
+        if (!std::fgets(buf, sizeof buf, f)) buf[0] = 0;
+        std::fclose(f);
+    }
+    std::string v(buf);
+    while (!v.empty() && std::isspace(static_cast<unsigned char>(v.back()))) v.pop_back();
+    return v.empty() ? "?" : v;
+}
+
+// /data/SMW/config.txt: NX_<KEY>=<value> per line ('#' starts a comment) into the environment.
+void load_config() {
+    FILE* f = std::fopen("/data/SMW/config.txt", "r");
+    if (!f) return;
+    char line[512];
+    int n = 0;
+    while (std::fgets(line, sizeof line, f)) {
+        std::string s(line);
+        if (auto hash = s.find('#'); hash != std::string::npos) s.resize(hash);
+        auto eq = s.find('=');
+        if (eq == std::string::npos) continue;
+        auto trim = [](std::string t) {
+            size_t a = t.find_first_not_of(" \t\r\n"), b = t.find_last_not_of(" \t\r\n");
+            return a == std::string::npos ? std::string() : t.substr(a, b - a + 1);
+        };
+        std::string key = trim(s.substr(0, eq)), value = trim(s.substr(eq + 1));
+        if (key.empty()) continue;
+        setenv(key.c_str(), value.c_str(), 1);
+        nx::plat::trace("config: %s=%s", key.c_str(), value.c_str());
+        n++;
+    }
+    std::fclose(f);
+    // svc_am.cpp only asks whether NX_HANDHELD exists: NX_HANDHELD=0 means docked, so it must go (as on Android).
+    if (const char* h = std::getenv("NX_HANDHELD"); h && h[0] == '0') unsetenv("NX_HANDHELD");
+    nx::plat::trace("config: %d settings from /data/SMW/config.txt", n);
+}
+
+void game_thread(void*) {
+    try {
+        nx::boot();
+    } catch (const nx::LongJmp& j) {
+        nx::fatal("longjmp to buffer %llx with no setjmp frame", (unsigned long long)j.buf);
+    } catch (const std::exception& e) {
+        // Where the game was when a host call threw: the guest registers still hold the call that failed.
+        nx::CPU& c = nx::current_cpu();
+        nx::log("host exception in a host call from the guest; guest lr %s", nx::describe(c.x[30]).c_str());
+        nx::backtrace(c);
+        size_t flex = 0;
+        ps4_available_flexible_main(&flex);
+        nx::log("flexible memory free: %zu MiB", flex >> 20);
+        nx::fatal("host exception: %s", e.what());
+    }
+    nx::plat::exit_process(0);
+}
+
+}  // namespace
+
+// The game's view of a crash, appended to crash.log by port/ps4_crashlog.cpp after the host's stacks: the guest
+// registers of the crashed thread.
+extern "C" void ps4_crash_guest_info() {
+    const int fd = open("/data/SMW/crash.log", O_WRONLY | O_CREAT | O_APPEND, 0666);
+    if (fd < 0) return;
+    char line[200];
+    nx::CPU& c = nx::current_cpu();
+    int n = std::snprintf(line, sizeof line, "\n== guest CPU at the crash: lr %016llx sp %016llx, lazy memory %llu MiB "
+                                             "mapped, %llu chunk maps failed\n",
+                          (unsigned long long)c.x[30], (unsigned long long)c.x[31],
+                          (unsigned long long)(nx::plat::ps4_lazy_mapped_bytes() >> 20),
+                          (unsigned long long)nx::plat::ps4_lazy_failed());
+    write(fd, line, size_t(n));
+    for (int k = 0; k < 32; k += 4) {
+        n = std::snprintf(line, sizeof line, "x%-2d %016llx %016llx %016llx %016llx\n", k,
+                          (unsigned long long)c.x[k], (unsigned long long)c.x[k + 1],
+                          (unsigned long long)c.x[k + 2], (unsigned long long)c.x[k + 3]);
+        write(fd, line, size_t(n));
+    }
+    std::string lr = nx::describe(c.x[30]);  // module+offset and the nearest symbol
+    n = std::snprintf(line, sizeof line, "guest lr: %s\n", lr.c_str());
+    write(fd, line, size_t(n));
+    close(fd);
+}
+
+int main() {
+    using namespace nx::plat;
+    load_system_modules();
+    mkdir(kDataRoot, 0777);
+    trace("SMW %s starting (%s)", app_version().c_str(), nx::game::kInfo.title);
+    load_config();
+    // PS4 defaults (config.txt overrides them): the game renders at 1280x720 and FidelityFX Super Resolution 1 (EASU,
+    // then RCAS sharpening) brings it to the TV's 1080p in the present pass (nvn_present.cpp).
+    setenv("NX_FSR", "1", 0);
+    setenv("NX_RENDER_RES", "1280x720", 0);
+    // Pipelined submits (the CPU does not wait for the GPU at the end of each frame, nvn_frames.cpp) and uniform
+    // buffers bound with dynamic offsets (descriptor sets reused, nvn_pipeline.cpp): course 1-1 from 25-27 fps to 30.
+    setenv("NX_PIPELINED", "1", 0);
+    setenv("NX_DYNAMIC_UBO", "1", 0);
+    // NX_PS4_GPU_FLUSH=1: every GPU cache written back and invalidated after every draw (slow). Tells a cache
+    // coherency problem (data the CPU or a later pass reads before the GPU's L2 wrote it out) from the rest.
+    if (const char* f = std::getenv("NX_PS4_GPU_FLUSH"); f && f[0] == '1') {
+        ac_ps4_flush_all_draws = 1;
+        trace("gpu: every cache flushed after every draw (NX_PS4_GPU_FLUSH)");
+    }
+    ps4::boot_screen_start();  // our own picture with a progress bar until the game's first frame
+    if (access("/data/SMW/profile.txt", F_OK) == 0) ps4_sampler_start();
+    detect_cores();
+    g_cross_confirms = !(std::getenv("NX_BUTTONS") && std::strcmp(std::getenv("NX_BUTTONS"), "nintendo") == 0);
+    ps4::settings_load(g_cross_confirms);  // the quick menu's settings (ps4_menu.cpp): button mapping, FSR
+    install_fault_handler();
+    register_thread();
+    // The host stacks' range (the guest's are reserved by nx::memory_init, on the game thread started below).
+    if (!reserve(kStacksBase, lazy::kEnd - kStacksBase)) trace("memory: no range for the thread stacks");
+
+    sceUserServiceInitialize(nullptr);
+    scePadInit();
+    scan_players();
+
+    start_memory_guard();  // memguard_ps4.cpp
+    trace("game thread");
+    // The game on its own thread, with a big stack (recompiled calls nest deeply); the main thread polls the pad.
+    start_thread(game_thread, nullptr, 64ull << 20);
+    for (;;) {
+        sample_input();
+        sleep_ns(4'000'000);
+    }
+}
diff --git a/runtime/src/ps4/ps4_boot_draw.cpp b/runtime/src/ps4/ps4_boot_draw.cpp
new file mode 100644
index 0000000..277d22b
--- /dev/null
+++ b/runtime/src/ps4/ps4_boot_draw.cpp
@@ -0,0 +1,134 @@
+// PS4 boot screen pictures: see ps4_boot_draw.h. The band that changes is composed in a host buffer (a copy of the
+// background under it, then the bar and the glyphs blended in) and copied out row by row.
+#include "ps4_boot_draw.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace nx::plat::ps4 {
+
+namespace {
+
+// Layout (1920x1080), as design A: the logo sits in the art at a third of the height; below it the bar, the stage
+// on the left and the percentage on the right under the bar, the credit line below them.
+constexpr int kBarX0 = 345, kBarX1 = 1575, kBarY = 618, kBarH = 36, kBorder = 5;
+constexpr int kTextY = 676;     // top of the stage / percentage cells
+constexpr int kCreditY = 760;   // top of the credit line's cells
+constexpr int kBandX0 = 300, kBandX1 = 1620, kBandY0 = 600, kBandY1 = 830;  // everything that changes
+
+struct Rgb {
+    uint8_t r, g, b;
+};
+constexpr Rgb kTrack{30, 44, 114}, kFill{255, 194, 31}, kWhite{255, 255, 255};
+
+std::vector<uint8_t> g_bg;  // kBootWidth x kBootHeight RGBA
+struct Font {
+    uint16_t cell_w = 0, cell_h = 0;
+    uint8_t first = 0, count = 0;
+    std::vector<uint8_t> advance, cells;  // RGBA cells
+} g_font;
+
+bool read_file(const std::string& path, std::vector<uint8_t>& out) {
+    FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) return false;
+    std::fseek(f, 0, SEEK_END);
+    long n = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    out.resize(n > 0 ? size_t(n) : 0);
+    bool ok = n > 0 && std::fread(out.data(), 1, out.size(), f) == out.size();
+    std::fclose(f);
+    return ok;
+}
+
+// The band: x kBandX0..kBandX1, y kBandY0..kBandY1, RGBA.
+constexpr int kBandW = kBandX1 - kBandX0, kBandH = kBandY1 - kBandY0;
+std::vector<uint8_t> g_band(size_t(kBandW) * kBandH * 4);
+
+void band_put(int x, int y, Rgb c, int alpha = 255) {
+    x -= kBandX0, y -= kBandY0;
+    if (x < 0 || y < 0 || x >= kBandW || y >= kBandH) return;
+    uint8_t* p = &g_band[(size_t(y) * kBandW + x) * 4];
+    p[0] = uint8_t((c.r * alpha + p[0] * (255 - alpha)) / 255);
+    p[1] = uint8_t((c.g * alpha + p[1] * (255 - alpha)) / 255);
+    p[2] = uint8_t((c.b * alpha + p[2] * (255 - alpha)) / 255);
+    p[3] = 255;
+}
+
+// A pill (rounded ends of radius h/2) from x0 to x1 at y, h high; edges anti-aliased by coverage.
+void pill(int x0, int x1, int y, int h, Rgb c) {
+    if (x1 <= x0) return;
+    const float r = h / 2.0f;
+    for (int py = y; py < y + h; py++)
+        for (int px = x0; px < x1; px++) {
+            float cx = px + 0.5f, cy = py + 0.5f - (y + r);
+            float dx = cx < x0 + r ? x0 + r - cx : cx > x1 - r ? cx - (x1 - r) : 0.0f;
+            float d = std::sqrt(dx * dx + cy * cy) - r;  // < 0 inside
+            float cover = std::clamp(0.5f - d, 0.0f, 1.0f);
+            if (cover > 0) band_put(px, py, c, int(cover * 255));
+        }
+}
+
+int text_width(const std::string& s) {
+    int w = 0;
+    for (unsigned char ch : s)
+        if (ch >= g_font.first && ch < g_font.first + g_font.count) w += g_font.advance[ch - g_font.first];
+    return w;
+}
+
+void text(const std::string& s, int x, int y) {
+    for (unsigned char ch : s) {
+        if (ch < g_font.first || ch >= g_font.first + g_font.count) continue;
+        int k = ch - g_font.first;
+        const uint8_t* cell = &g_font.cells[size_t(k) * g_font.cell_w * g_font.cell_h * 4];
+        for (int cy = 0; cy < g_font.cell_h; cy++)
+            for (int cx = 0; cx < g_font.cell_w; cx++) {
+                const uint8_t* p = cell + (size_t(cy) * g_font.cell_w + cx) * 4;
+                if (p[3]) band_put(x + cx, y + cy, Rgb{p[0], p[1], p[2]}, p[3]);
+            }
+        x += g_font.advance[k];
+    }
+}
+
+}  // namespace
+
+bool boot_draw_load(const std::string& dir) {
+    std::vector<uint8_t> font;
+    if (!read_file(dir + "/background.rgba", g_bg) || g_bg.size() != size_t(kBootWidth) * kBootHeight * 4) return false;
+    if (!read_file(dir + "/font.bin", font) || font.size() < 10 || std::memcmp(font.data(), "SMWF", 4) != 0) return false;
+    g_font.cell_w = uint16_t(font[4] | font[5] << 8);
+    g_font.cell_h = uint16_t(font[6] | font[7] << 8);
+    g_font.first = font[8];
+    g_font.count = font[9];
+    size_t cells = size_t(g_font.count) * g_font.cell_w * g_font.cell_h * 4;
+    if (font.size() != 10 + g_font.count + cells) return false;
+    g_font.advance.assign(font.begin() + 10, font.begin() + 10 + g_font.count);
+    g_font.cells.assign(font.begin() + 10 + g_font.count, font.end());
+    return true;
+}
+
+void boot_draw(uint8_t* fb, uint32_t pitch, const BootView& view, bool full) {
+    if (full)
+        for (uint32_t y = 0; y < kBootHeight; y++)
+            std::memcpy(fb + size_t(y) * pitch * 4, &g_bg[size_t(y) * kBootWidth * 4], size_t(kBootWidth) * 4);
+    // the band: background, then the bar and the texts
+    for (int y = 0; y < kBandH; y++)
+        std::memcpy(&g_band[size_t(y) * kBandW * 4], &g_bg[(size_t(kBandY0 + y) * kBootWidth + kBandX0) * 4],
+                    size_t(kBandW) * 4);
+    pill(kBarX0 - kBorder, kBarX1 + kBorder, kBarY - kBorder, kBarH + 2 * kBorder, kWhite);
+    pill(kBarX0, kBarX1, kBarY, kBarH, kTrack);
+    int pct = std::clamp(view.percent, 0, 100);
+    int fill = (kBarX1 - kBarX0) * pct / 100;
+    if (fill >= kBarH) pill(kBarX0, kBarX0 + fill, kBarY, kBarH, kFill);
+    text(view.stage, kBarX0, kTextY);
+    std::string p = std::to_string(pct) + "%";
+    text(p, kBarX1 - text_width(p), kTextY);
+    text(view.credit, (int(kBootWidth) - text_width(view.credit)) / 2, kCreditY);
+    for (int y = 0; y < kBandH; y++)
+        std::memcpy(fb + (size_t(kBandY0 + y) * pitch + kBandX0) * 4, &g_band[size_t(y) * kBandW * 4],
+                    size_t(kBandW) * 4);
+}
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_boot_draw.h b/runtime/src/ps4/ps4_boot_draw.h
new file mode 100644
index 0000000..3855266
--- /dev/null
+++ b/runtime/src/ps4/ps4_boot_draw.h
@@ -0,0 +1,26 @@
+// PS4 boot screen pictures (ps4_boot_draw.cpp): the home screen art with a progress bar, the stage, the percentage
+// and the credit line, drawn by the CPU into a linear 1920x1080 RGBA framebuffer. No PS4 calls: tools/ can build it
+// on the PC to preview a frame.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace nx::plat::ps4 {
+
+constexpr uint32_t kBootWidth = 1920, kBootHeight = 1080;
+
+struct BootView {
+    std::string stage;  // "Loading game files: 412 MB"
+    int percent = 0;    // 0..100
+    std::string credit;  // under the bar
+};
+
+// Reads <dir>/background.rgba and <dir>/font.bin (scripts/make-art.py --boot). False if either is missing or bad.
+bool boot_draw_load(const std::string& dir);
+
+// The whole picture (`full`) or only the band that changes (the bar, the texts), into `fb` (rows of `pitch` pixels).
+// Writes only, never reads `fb` (the PS4's framebuffers are write-combined memory).
+void boot_draw(uint8_t* fb, uint32_t pitch, const BootView& view, bool full);
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_boot_screen.cpp b/runtime/src/ps4/ps4_boot_screen.cpp
new file mode 100644
index 0000000..d1393cd
--- /dev/null
+++ b/runtime/src/ps4/ps4_boot_screen.cpp
@@ -0,0 +1,180 @@
+// PS4 boot screen: see ps4_boot_screen.h. Two linear 1920x1080 buffers in write-combined direct memory, registered as
+// VideoOut buffers 12 and 13 (the swapchain uses 0-3 and 8-11), drawn by the CPU (ps4_boot_draw.cpp) and flipped at
+// 30 fps on a thread of their own until the game presents.
+//
+// Progress: the game data read so far against what the last boot had read by its first frame, or the time against
+// the last boot's time, whichever is further (/data/SMW/boot-profile.txt, written at each first frame; the first boot
+// guesses). The bar eases towards that and never goes back.
+#include "ps4_boot_screen.h"
+
+#include <sys/types.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <mutex>
+#include <thread>
+
+#include <orbis/SystemService.h>
+#include <orbis/VideoOut.h>
+#include <orbis/libkernel.h>
+
+#include <nx/runtime.h>
+
+#include "ps4_boot_draw.h"
+#include "ps4_menu.h"
+
+extern "C" {
+int32_t ps4bs_allocate_direct(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t* phys) __asm__(
+    "sceKernelAllocateDirectMemory");
+int32_t ps4bs_map_direct(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align) __asm__(
+    "sceKernelMapDirectMemory");
+size_t ps4bs_direct_memory_size() __asm__("sceKernelGetDirectMemorySize");
+void ps4_boot_trace(const char* line);
+}
+
+namespace nx::plat::ps4 {
+
+namespace {
+
+constexpr int kFirstBuffer = 12;
+constexpr size_t kBufferSize = 8ull << 20;  // 1920x1080x4 rounded up to 2 MiB pages
+constexpr int32_t kWcGarlic = 3;            // SCE_KERNEL_WC_GARLIC: write-combined, what the display reads
+constexpr int32_t kProtCpuGpu = 0x33;       // CPU read/write, GPU read/write
+const char* const kProfile = "/data/SMW/boot-profile.txt";
+
+std::mutex g_video_lock;
+int g_video = -1;
+OrbisKernelEqueue g_flip_queue;
+
+std::atomic<bool> g_stop{false}, g_running{false}, g_graphics{false};
+std::atomic<uint64_t> g_bytes{0};
+std::thread g_thread;
+uint8_t* g_buffers[2] = {};  // kept after the game starts: the quick menu draws on them (ps4_menu.cpp)
+bool g_registered = false;
+std::once_flag g_stopped;
+std::chrono::steady_clock::time_point g_start;
+
+void trace(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void trace(const char* fmt, ...) {
+    char line[200];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof line, fmt, ap);
+    va_end(ap);
+    ps4_boot_trace(line);
+}
+
+void draw_loop(uint8_t* buffers[2]) {
+    // what the last boot needed by its first frame; the first boot's guess
+    double want_bytes = 400.0 * (1 << 20), want_secs = 60.0;
+    if (FILE* f = std::fopen(kProfile, "r")) {
+        unsigned long long b = 0;
+        double s = 0;
+        if (std::fscanf(f, "%llu %lf", &b, &s) == 2 && b > (16u << 20) && s > 3) want_bytes = double(b), want_secs = s;
+        std::fclose(f);
+    }
+    BootView view;
+    view.credit = "by ShiroKlein";
+    double shown = 0;
+    int k = 0;
+    for (uint64_t frame = 0; !g_stop; frame++) {
+        double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_start).count();
+        uint64_t bytes = g_bytes.load();
+        double target = std::max(double(bytes) / want_bytes, secs / want_secs);
+        if (g_graphics) target = std::max(target, 0.9);
+        target = std::min(target, 0.99);
+        shown = std::max(shown, shown + (target - shown) * 0.15);
+        char stage[96];
+        if (g_graphics)
+            std::snprintf(stage, sizeof stage, "Preparing graphics");
+        else if (bytes)
+            std::snprintf(stage, sizeof stage, "Loading game files: %llu MB", (unsigned long long)(bytes >> 20));
+        else
+            std::snprintf(stage, sizeof stage, "Starting the game");
+        view.stage = stage;
+        view.percent = int(shown * 100);
+        // each buffer gets the whole picture once, then only the band that changes
+        boot_draw(buffers[k], kBootWidth, view, frame < 2);
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);  // write-combined stores out before the flip
+        sceVideoOutSubmitFlip(g_video, kFirstBuffer + k, ORBIS_VIDEO_OUT_FLIP_VSYNC, 0);
+        if (frame == 0) sceSystemServiceHideSplashScreen();
+        k ^= 1;
+        std::this_thread::sleep_for(std::chrono::milliseconds(33));  // the other buffer is off screen by then
+    }
+}
+
+}  // namespace
+
+int video_out() {
+    std::lock_guard lk(g_video_lock);
+    if (g_video >= 0) return g_video;
+    g_video = sceVideoOutOpen(0xFF, 0, 0, nullptr);
+    if (g_video < 0) {
+        log("ps4: sceVideoOutOpen failed: %x", unsigned(g_video));
+        return g_video;
+    }
+    sceKernelCreateEqueue(&g_flip_queue, "smw flip");
+    sceVideoOutAddFlipEvent(g_flip_queue, g_video, nullptr);
+    return g_video;
+}
+
+void* video_out_flip_queue() { return &g_flip_queue; }
+uint8_t* boot_buffer(int k) { return g_registered && k >= 0 && k < 2 ? g_buffers[k] : nullptr; }
+int boot_buffer_index(int k) { return kFirstBuffer + k; }
+
+void boot_note_bytes(uint64_t bytes) { g_bytes.fetch_add(bytes, std::memory_order_relaxed); }
+void boot_note_graphics() { g_graphics = true; }
+
+void boot_screen_start() {
+    g_start = std::chrono::steady_clock::now();
+    if (!boot_draw_load("/app0/boot")) {
+        trace("boot screen: no assets in /app0/boot: the system splash stays");
+        return;
+    }
+    if (video_out() < 0) return;
+    off_t phys = 0;
+    void* base = nullptr;
+    if (ps4bs_allocate_direct(0, off_t(ps4bs_direct_memory_size()), 2 * kBufferSize, 2 << 20, kWcGarlic, &phys) != 0 ||
+        ps4bs_map_direct(&base, 2 * kBufferSize, kProtCpuGpu, 0, phys, 2 << 20) != 0) {
+        trace("boot screen: no direct memory for its buffers");
+        return;
+    }
+    static uint8_t* buffers[2] = {static_cast<uint8_t*>(base), static_cast<uint8_t*>(base) + kBufferSize};
+    g_buffers[0] = buffers[0], g_buffers[1] = buffers[1];
+    void* addresses[2] = {buffers[0], buffers[1]};
+    OrbisVideoOutBufferAttribute attribute;
+    sceVideoOutSetBufferAttribute(&attribute, ORBIS_VIDEO_OUT_PIXEL_FORMAT_A8B8G8R8_SRGB,
+                                  ORBIS_VIDEO_OUT_TILING_MODE_LINEAR, 0, kBootWidth, kBootHeight, kBootWidth);
+    int set = sceVideoOutRegisterBuffers(g_video, kFirstBuffer, addresses, 2, &attribute);
+    if (set < 0) {
+        trace("boot screen: sceVideoOutRegisterBuffers failed: %x", unsigned(set));
+        return;
+    }
+    g_registered = true;
+    g_running = true;
+    g_thread = std::thread([] { draw_loop(buffers); });
+    trace("boot screen: drawing");
+}
+
+void boot_screen_stop() {
+    std::call_once(g_stopped, [] {
+        double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_start).count();
+        if (g_running) {
+            g_stop = true;
+            g_thread.join();
+        }
+        if (FILE* f = std::fopen(kProfile, "w")) {
+            std::fprintf(f, "%llu %.1f\n", (unsigned long long)g_bytes.load(), secs);
+            std::fclose(f);
+        }
+        trace("boot screen: first game frame after %.1f s, %llu MB read", secs,
+              (unsigned long long)(g_bytes.load() >> 20));
+        log("ps4: first game frame after %.1f s, %llu MB of game data read", secs,
+            (unsigned long long)(g_bytes.load() >> 20));
+    });
+}
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_boot_screen.h b/runtime/src/ps4/ps4_boot_screen.h
new file mode 100644
index 0000000..3959be4
--- /dev/null
+++ b/runtime/src/ps4/ps4_boot_screen.h
@@ -0,0 +1,23 @@
+// PS4 boot screen (ps4_boot_screen.cpp): from the start of the app until the game's first frame, a picture of our own
+// on VideoOut instead of the system's still splash: the art, a progress bar, what is being done and the credit.
+#pragma once
+
+#include <cstdint>
+
+namespace nx::plat::ps4 {
+
+// main(): shows the boot screen (from /app0/boot) on its own thread. Nothing happens if the assets are missing.
+void boot_screen_start();
+// The game's first present (ps4_vk_wsi.cpp), before its flip: the boot screen stops drawing (returns once it has)
+// and keeps this boot's numbers for the next one's progress bar. Later calls do nothing.
+void boot_screen_stop();
+// Progress: bytes of game data read so far (platform_ps4.cpp read_at), the Vulkan device made (ps4_vk_wsi.cpp).
+void boot_note_bytes(uint64_t bytes);
+void boot_note_graphics();
+
+// The app's one VideoOut handle (opened on first use, with its flip event queue): the boot screen and the swapchain
+// (ps4_vk_wsi.cpp) share it. Negative when VideoOut could not be opened.
+int video_out();
+void* video_out_flip_queue();  // the OrbisKernelEqueue its flip events arrive on
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_menu.cpp b/runtime/src/ps4/ps4_menu.cpp
new file mode 100644
index 0000000..d2664a6
--- /dev/null
+++ b/runtime/src/ps4/ps4_menu.cpp
@@ -0,0 +1,574 @@
+// PS4 quick menu: see ps4_menu.h. Drawn by the CPU into the boot screen's write-combined VideoOut buffers: each gets
+// the dimmed frame once, then only the panel is composed (in a host buffer, since write-combined memory is slow to
+// read) and copied out. Text: /app0/boot/menu_font.bin (plain glyphs, coloured here, with a drop shadow); the title
+// uses the boot screen's outlined font.bin as it is. SMW_MENU_PREVIEW builds the drawing alone on a PC
+// (scripts/menu-preview.sh): no PS4 calls then.
+#include "ps4_menu.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(SMW_MENU_PREVIEW)
+enum : uint32_t {
+    ORBIS_PAD_BUTTON_L3 = 0x0002, ORBIS_PAD_BUTTON_R3 = 0x0004, ORBIS_PAD_BUTTON_OPTIONS = 0x0008,
+    ORBIS_PAD_BUTTON_UP = 0x0010, ORBIS_PAD_BUTTON_RIGHT = 0x0020, ORBIS_PAD_BUTTON_DOWN = 0x0040,
+    ORBIS_PAD_BUTTON_LEFT = 0x0080, ORBIS_PAD_BUTTON_L2 = 0x0100, ORBIS_PAD_BUTTON_R2 = 0x0200,
+    ORBIS_PAD_BUTTON_L1 = 0x0400, ORBIS_PAD_BUTTON_R1 = 0x0800, ORBIS_PAD_BUTTON_TRIANGLE = 0x1000,
+    ORBIS_PAD_BUTTON_CIRCLE = 0x2000, ORBIS_PAD_BUTTON_CROSS = 0x4000, ORBIS_PAD_BUTTON_SQUARE = 0x8000,
+    ORBIS_PAD_BUTTON_TOUCH_PAD = 0x100000,
+};
+#define log(...) std::printf(__VA_ARGS__), std::printf("\n")
+#else
+#include <orbis/Pad.h>
+#include <orbis/SystemService.h>
+#include <orbis/VideoOut.h>
+
+#include <nx/runtime.h>
+#endif
+
+namespace nx::plat::ps4 {
+
+#if !defined(SMW_MENU_PREVIEW)
+// platform_ps4.cpp: player 1's DualShock 4 as it is (buttons, left stick y), and a storyboard request.
+bool menu_pad(uint32_t& buttons, uint8_t& left_y);
+void request_diag();
+#endif
+
+namespace {
+
+constexpr uint32_t kW = 1920, kH = 1080;
+constexpr const char* kConfig = "/data/SMW/config.txt";
+
+// ---- settings -----------------------------------------------------------------------------------------------------
+
+struct Res {
+    const char* label;
+    const char* value;  // NX_RENDER_RES, or null for handheld mode
+};
+// FSR 1's quality modes (render scale per axis: 1.3, 1.5, 1.7, 2.0) against the 1080p screen, and native.
+constexpr Res kResolutions[] = {
+    {"Native 1920x1080", "1920x1080"},       {"FSR Ultra Quality 1476x830", "1476x830"},
+    {"FSR Quality 1280x720", "1280x720"},    {"FSR Balanced 1128x634", "1128x634"},
+    {"FSR Performance 960x540", "960x540"},  {"Handheld mode 1280x720", nullptr},
+};
+constexpr int kResCount = int(sizeof kResolutions / sizeof kResolutions[0]);
+constexpr int kResDefault = 2;  // FSR Quality (platform_ps4.cpp's default NX_RENDER_RES)
+constexpr const char* kCores[] = {"balanced", "pinned", "spread"};
+constexpr const char* kCounter[] = {"Off", "FPS", "FPS and frame time"};
+
+struct Ds4 {
+    const char* name;  // in config.txt and on screen
+    uint32_t bit;
+};
+constexpr Ds4 kDs4[] = {
+    {"Cross", ORBIS_PAD_BUTTON_CROSS},       {"Circle", ORBIS_PAD_BUTTON_CIRCLE}, {"Square", ORBIS_PAD_BUTTON_SQUARE},
+    {"Triangle", ORBIS_PAD_BUTTON_TRIANGLE}, {"L1", ORBIS_PAD_BUTTON_L1},         {"R1", ORBIS_PAD_BUTTON_R1},
+    {"L2", ORBIS_PAD_BUTTON_L2},             {"R2", ORBIS_PAD_BUTTON_R2},         {"L3", ORBIS_PAD_BUTTON_L3},
+    {"R3", ORBIS_PAD_BUTTON_R3},             {"Options", ORBIS_PAD_BUTTON_OPTIONS},
+    {"Touchpad", ORBIS_PAD_BUTTON_TOUCH_PAD},
+};
+constexpr int kDs4Count = int(sizeof kDs4 / sizeof kDs4[0]);
+constexpr const char* kNxNames[kNxCount] = {"A", "B", "X", "Y", "L", "R", "ZL", "ZR", "Plus", "Minus",
+                                            "Left stick click", "Right stick click"};
+constexpr const char* kNxKeys[kNxCount] = {"A", "B", "X", "Y", "L", "R", "ZL", "ZR", "PLUS", "MINUS", "LS", "RS"};
+
+struct Settings {
+    int res = kResDefault;  // kResolutions
+    bool fsr = true;
+    float sharp = 0.2f;     // FSR stops: 0 sharpest, 2 none
+    int cores = 0;          // kCores
+    int counter = 0;        // kCounter
+    int map[kNxCount];      // kDs4 index per Switch button, -1 none
+};
+Settings g_set;
+bool g_cross = true;
+std::atomic<bool> g_fsr{true};
+std::atomic<float> g_sharp{0.2f};
+std::atomic<int> g_counter{0};
+std::atomic<uint32_t> g_map_bits[kNxCount];
+std::atomic<bool> g_request{false}, g_open{false}, g_hold_after{false};
+
+void default_map(int map[kNxCount]) {
+    auto at = [](const char* n) {
+        for (int k = 0; k < kDs4Count; k++)
+            if (std::strcmp(kDs4[k].name, n) == 0) return k;
+        return -1;
+    };
+    map[kNxA] = at(g_cross ? "Cross" : "Circle");
+    map[kNxB] = at(g_cross ? "Circle" : "Cross");
+    map[kNxX] = at("Triangle"), map[kNxY] = at("Square");
+    map[kNxL] = at("L1"), map[kNxR] = at("R1"), map[kNxZL] = at("L2"), map[kNxZR] = at("R2");
+    map[kNxPlus] = at("Options"), map[kNxMinus] = at("Touchpad"), map[kNxLS] = at("L3"), map[kNxRS] = at("R3");
+}
+
+void publish() {
+    g_fsr = g_set.fsr;
+    g_sharp = g_set.sharp;
+    g_counter = g_set.counter;
+    for (int k = 0; k < kNxCount; k++) g_map_bits[k] = g_set.map[k] >= 0 ? kDs4[g_set.map[k]].bit : 0;
+}
+
+std::string map_string(const int map[kNxCount]) {
+    std::string s;
+    for (int k = 0; k < kNxCount; k++) {
+        if (!s.empty()) s += ',';
+        s += kNxKeys[k];
+        s += ':';
+        s += map[k] >= 0 ? kDs4[map[k]].name : "none";
+    }
+    return s;
+}
+
+void parse_map(const char* text, int map[kNxCount]) {
+    std::string s = text;
+    size_t at = 0;
+    while (at < s.size()) {
+        size_t end = s.find(',', at);
+        if (end == std::string::npos) end = s.size();
+        std::string item = s.substr(at, end - at);
+        at = end + 1;
+        size_t colon = item.find(':');
+        if (colon == std::string::npos) continue;
+        std::string key = item.substr(0, colon), value = item.substr(colon + 1);
+        for (int k = 0; k < kNxCount; k++)
+            if (key == kNxKeys[k]) {
+                map[k] = -1;
+                for (int d = 0; d < kDs4Count; d++)
+                    if (value == kDs4[d].name) map[k] = d;
+            }
+    }
+}
+
+// config.txt with the menu's keys replaced (other lines, comments included, stay as they are).
+void save() {
+    static const char* const kOwned[] = {"NX_RENDER_RES", "NX_HANDHELD", "NX_FSR", "NX_FSR_SHARP", "NX_PS4_CORES",
+                                         "NX_PS4_MAP", "NX_PS4_FPS"};
+    std::vector<std::string> lines;
+    if (FILE* f = std::fopen(kConfig, "r")) {
+        char buf[512];
+        while (std::fgets(buf, sizeof buf, f)) {
+            std::string line = buf;
+            while (!line.empty() && (line.back() == '\n' || line.back() == '\r')) line.pop_back();
+            bool owned = false;
+            for (const char* k : kOwned) owned |= line.compare(0, std::strlen(k) + 1, std::string(k) + "=") == 0;
+            if (!owned) lines.push_back(line);
+        }
+        std::fclose(f);
+    }
+    const Res& r = kResolutions[g_set.res];
+    char sharp[16];
+    std::snprintf(sharp, sizeof sharp, "%.1f", double(g_set.sharp));
+    if (r.value)
+        lines.push_back(std::string("NX_RENDER_RES=") + r.value), lines.push_back("NX_HANDHELD=0");
+    else
+        lines.push_back("NX_HANDHELD=1");
+    lines.push_back(std::string("NX_FSR=") + (g_set.fsr ? "1" : "0"));
+    lines.push_back(std::string("NX_FSR_SHARP=") + sharp);
+    lines.push_back(std::string("NX_PS4_CORES=") + kCores[g_set.cores]);
+    lines.push_back("NX_PS4_FPS=" + std::to_string(g_set.counter));
+    lines.push_back("NX_PS4_MAP=" + map_string(g_set.map));
+    std::string tmp = std::string(kConfig) + ".tmp";
+    if (FILE* f = std::fopen(tmp.c_str(), "w")) {
+        for (const std::string& l : lines) std::fprintf(f, "%s\n", l.c_str());
+        if (std::fclose(f) == 0) std::rename(tmp.c_str(), kConfig);
+    }
+    log("menu: settings saved (%s, FSR %s %.1f, cores %s, counter %d)", r.label, g_set.fsr ? "on" : "off",
+        double(g_set.sharp), kCores[g_set.cores], g_set.counter);
+}
+
+// ---- drawing --------------------------------------------------------------------------------------------------------
+
+struct Font {
+    uint16_t cell_w = 0, cell_h = 0;
+    uint8_t first = 0, count = 0;
+    std::vector<uint8_t> advance, cells;  // RGBA cells
+};
+Font g_text, g_title;
+
+bool load_font(Font& font, const char* path) {
+    if (!font.cells.empty()) return true;
+    FILE* f = std::fopen(path, "rb");
+    if (!f) return false;
+    std::vector<uint8_t> d;
+    uint8_t buf[65536];
+    for (size_t n; (n = std::fread(buf, 1, sizeof buf, f)) > 0;) d.insert(d.end(), buf, buf + n);
+    std::fclose(f);
+    if (d.size() < 10 || std::memcmp(d.data(), "SMWF", 4) != 0) return false;
+    font.cell_w = uint16_t(d[4] | d[5] << 8), font.cell_h = uint16_t(d[6] | d[7] << 8);
+    font.first = d[8], font.count = d[9];
+    size_t cells = size_t(font.count) * font.cell_w * font.cell_h * 4;
+    if (d.size() != 10 + font.count + cells) return false;
+    font.advance.assign(d.begin() + 10, d.begin() + 10 + font.count);
+    font.cells.assign(d.begin() + 10 + font.count, d.end());
+    return true;
+}
+
+struct Rgb {
+    uint8_t r, g, b;
+};
+constexpr Rgb kPanel{16, 22, 64}, kGold{255, 194, 31}, kWhite{245, 247, 255}, kNavy{16, 20, 60}, kGrey{170, 180, 215},
+    kAmber{255, 214, 120}, kShadow{0, 0, 0};
+
+// A canvas: the panel's host buffer or the frame counter's label.
+struct Canvas {
+    uint8_t* px;
+    int w, h;
+    void put(int x, int y, Rgb c, int a) {
+        if (x < 0 || y < 0 || x >= w || y >= h || a <= 0) return;
+        uint8_t* p = px + (size_t(y) * w + x) * 4;
+        p[0] = uint8_t((c.r * a + p[0] * (255 - a)) / 255);
+        p[1] = uint8_t((c.g * a + p[1] * (255 - a)) / 255);
+        p[2] = uint8_t((c.b * a + p[2] * (255 - a)) / 255);
+        p[3] = 255;
+    }
+    void rect(int x0, int y0, int x1, int y1, Rgb c, int a) {
+        for (int y = std::max(0, y0); y < std::min(h, y1); y++)
+            for (int x = std::max(0, x0); x < std::min(w, x1); x++) put(x, y, c, a);
+    }
+};
+
+int text_width(const Font& f, const std::string& s) {
+    int w = 0;
+    for (unsigned char ch : s)
+        if (ch >= f.first && ch < f.first + f.count) w += f.advance[ch - f.first];
+    return w;
+}
+
+// `tint`: the colour of the plain menu font's glyphs; the title font keeps its own colours (no tint).
+void glyphs(Canvas& cv, const Font& f, const std::string& s, int x, int y, const Rgb* tint, int alpha = 255) {
+    for (unsigned char ch : s) {
+        if (ch < f.first || ch >= f.first + f.count) continue;
+        int k = ch - f.first;
+        const uint8_t* cell = &f.cells[size_t(k) * f.cell_w * f.cell_h * 4];
+        for (int cy = 0; cy < f.cell_h; cy++)
+            for (int cx = 0; cx < f.cell_w; cx++) {
+                const uint8_t* p = cell + (size_t(cy) * f.cell_w + cx) * 4;
+                if (p[3]) cv.put(x + cx, y + cy, tint ? *tint : Rgb{p[0], p[1], p[2]}, p[3] * alpha / 255);
+            }
+        x += f.advance[k];
+    }
+}
+
+// Menu text: a soft shadow under it keeps it readable over anything.
+void text(Canvas& cv, const std::string& s, int x, int y, Rgb c, bool shadow = true) {
+    if (shadow) glyphs(cv, g_text, s, x + 2, y + 2, &kShadow, 150);
+    glyphs(cv, g_text, s, x, y, &c);
+}
+
+// The panel, composed in a host buffer (x kPx..kPx+kPw, y kPy..kPy+kPh of the screen).
+constexpr int kPw = 1200, kPh = 920, kPx = (int(kW) - kPw) / 2, kPy = (int(kH) - kPh) / 2;
+constexpr int kRowH = 52, kTop = 136, kVisible = 12;
+std::vector<uint8_t> g_panel(size_t(kPw) * kPh * 4);
+std::vector<uint8_t> g_dim;  // the frame, dimmed, kW x kH RGBA
+
+struct Row {
+    std::string label, value;
+    bool restart = false;  // applies at the next start
+};
+
+void draw_panel(const std::string& title, const std::vector<Row>& rows, int selected, const std::string& footer,
+                const std::string& note) {
+    Canvas cv{g_panel.data(), kPw, kPh};
+    for (int y = 0; y < kPh; y++)  // the dimmed frame under the panel
+        std::memcpy(&g_panel[size_t(y) * kPw * 4], &g_dim[(size_t(kPy + y) * kW + kPx) * 4], size_t(kPw) * 4);
+    cv.rect(0, 0, kPw, kPh, kPanel, 232);
+    cv.rect(0, 0, kPw, 6, kGold, 255);
+    glyphs(cv, g_title, title, 44, 30, nullptr);
+    // a window of kVisible rows that keeps the selection in view
+    int n = int(rows.size()), first = 0;
+    if (n > kVisible) first = std::clamp(selected - kVisible / 2, 0, n - kVisible);
+    for (int k = first; k < std::min(n, first + kVisible); k++) {
+        int y = kTop + (k - first) * kRowH;
+        bool sel = k == selected;
+        if (sel) cv.rect(28, y - 4, kPw - 28, y + kRowH - 6, kGold, 245);
+        Rgb c = sel ? kNavy : kWhite;
+        text(cv, rows[k].label + (rows[k].restart ? " *" : ""), 56, y, c, !sel);
+        if (!rows[k].value.empty()) {
+            std::string v = sel && rows[k].value != ">" ? "<  " + rows[k].value + "  >" : rows[k].value;
+            text(cv, v, kPw - 56 - text_width(g_text, v), y, c, !sel);
+        }
+    }
+    if (first > 0) text(cv, "...", kPw / 2 - 20, kTop - 40, kGrey);
+    if (first + kVisible < n) text(cv, "...", kPw / 2 - 20, kTop + kVisible * kRowH - 14, kGrey);
+    cv.rect(28, kPh - 128, kPw - 28, kPh - 126, kGrey, 120);
+    text(cv, footer, 56, kPh - 112, kGrey);
+    text(cv, note, 56, kPh - 64, kAmber);
+}
+
+// ---- the menu's pages -------------------------------------------------------------------------------------------------
+
+enum class Page { Main, Controls, Bind };
+
+struct Input {
+    uint32_t held = 0, pressed = 0;
+    int repeat_dir = 0, repeat_ticks = 0;
+    bool up = false, down = false;  // with the stick and auto-repeat
+};
+
+void step(Input& in, uint32_t b, uint8_t ly) {
+    if (ly < 50) b |= ORBIS_PAD_BUTTON_UP;
+    if (ly > 206) b |= ORBIS_PAD_BUTTON_DOWN;
+    in.pressed = b & ~in.held;
+    in.held = b;
+    int dir = (b & ORBIS_PAD_BUTTON_UP) ? -1 : (b & ORBIS_PAD_BUTTON_DOWN) ? 1 : 0;
+    in.up = in.down = false;
+    if (dir != in.repeat_dir) in.repeat_dir = dir, in.repeat_ticks = 0;
+    if (dir && (in.repeat_ticks == 0 || (in.repeat_ticks > 12 && in.repeat_ticks % 4 == 0))) (dir < 0 ? in.up : in.down) = true;
+    if (dir) in.repeat_ticks++;
+}
+
+struct MenuState {
+    Page page = Page::Main;
+    int sel = 0, ctl_sel = 0, bind_target = 0;
+    bool released = false;  // Bind: every button let go since the page opened
+    bool done = false, restart = false, diag = false;
+    std::string note = "* applies when the game starts again";
+};
+
+// One frame of the menu: input in, rows out.
+void menu_frame(MenuState& m, const Input& in, std::string& title, std::vector<Row>& rows, std::string& footer, int& sel) {
+    rows.clear();
+    if (m.page == Page::Main) {
+        char sharp[32];
+        std::snprintf(sharp, sizeof sharp, "%.1f", double(g_set.sharp));
+        title = "SMW quick menu";
+        rows = {{"Resume", ""},
+                {"Render resolution", kResolutions[g_set.res].label, true},
+                {"Upscaling", g_set.fsr ? "FSR 1" : "Bilinear"},
+                {"FSR sharpness (0 = sharpest)", sharp},
+                {"Frame counter", kCounter[g_set.counter]},
+                {"CPU cores", kCores[g_set.cores], true},
+                {"Controls", ">"},
+                {"Capture a diagnostics frame", ""},
+                {"Restart the game now", ""}};
+        footer = "Up/Down choose  Left/Right change  Cross OK  Circle close";
+        int n = int(rows.size());
+        if (in.up) m.sel = (m.sel + n - 1) % n;
+        if (in.down) m.sel = (m.sel + 1) % n;
+        int dx = (in.pressed & ORBIS_PAD_BUTTON_RIGHT) ? 1 : (in.pressed & ORBIS_PAD_BUTTON_LEFT) ? -1 : 0;
+        bool ok = in.pressed & ORBIS_PAD_BUTTON_CROSS;
+        if (ok && dx == 0) dx = 1;
+        switch (m.sel) {
+            case 0: if (ok) m.done = true; break;
+            case 1: if (dx) g_set.res = (g_set.res + kResCount + dx) % kResCount; break;
+            case 2: if (dx) g_set.fsr = !g_set.fsr; break;
+            case 3:
+                if (dx) g_set.sharp = std::clamp(std::round((g_set.sharp + 0.1f * float(dx)) * 10.0f) / 10.0f, 0.0f, 2.0f);
+                break;
+            case 4: if (dx) g_set.counter = (g_set.counter + 3 + dx) % 3; break;
+            case 5: if (dx) g_set.cores = (g_set.cores + 3 + dx) % 3; break;
+            case 6: if (ok || dx > 0) m.page = Page::Controls, m.ctl_sel = 0; break;
+            case 7: if (ok) m.diag = m.done = true; break;
+            case 8: if (ok) m.restart = m.done = true; break;
+        }
+        if (in.pressed & ORBIS_PAD_BUTTON_CIRCLE) m.done = true;
+        const uint32_t both = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+        if ((in.held & both) == both && (in.pressed & both)) m.done = true;
+        sel = m.sel;
+    } else if (m.page == Page::Controls) {
+        title = "Controls";
+        for (int b = 0; b < kNxCount; b++)
+            rows.push_back({std::string("Switch ") + kNxNames[b], g_set.map[b] >= 0 ? kDs4[g_set.map[b]].name : "none"});
+        rows.push_back({"Reset to defaults", ""});
+        rows.push_back({"Back", ""});
+        footer = "Cross: then press the new button  Circle back";
+        int n = int(rows.size());
+        if (in.up) m.ctl_sel = (m.ctl_sel + n - 1) % n;
+        if (in.down) m.ctl_sel = (m.ctl_sel + 1) % n;
+        if (in.pressed & ORBIS_PAD_BUTTON_CROSS) {
+            if (m.ctl_sel < kNxCount) m.page = Page::Bind, m.bind_target = m.ctl_sel, m.released = false;
+            else if (m.ctl_sel == kNxCount) default_map(g_set.map);
+            else m.page = Page::Main;
+        }
+        if (in.pressed & ORBIS_PAD_BUTTON_CIRCLE) m.page = Page::Main;
+        sel = m.ctl_sel;
+    } else {  // Bind: the next button pressed (after everything was let go)
+        title = "Controls";
+        rows = {{std::string("Press the button for Switch ") + kNxNames[m.bind_target], ""},
+                {"The D-pad cancels", ""}};
+        footer = "";
+        if (in.held == 0) m.released = true;
+        if (m.released && in.pressed) {
+            uint32_t p = in.pressed;
+            if (!(p & (ORBIS_PAD_BUTTON_UP | ORBIS_PAD_BUTTON_DOWN | ORBIS_PAD_BUTTON_LEFT | ORBIS_PAD_BUTTON_RIGHT)))
+                for (int d = 0; d < kDs4Count; d++)
+                    if (p & kDs4[d].bit) {
+                        // the Switch button that had the new one gets this one's old button (a swap)
+                        for (int b = 0; b < kNxCount; b++)
+                            if (b != m.bind_target && g_set.map[b] == d) g_set.map[b] = g_set.map[m.bind_target];
+                        g_set.map[m.bind_target] = d;
+                        break;
+                    }
+            m.page = Page::Controls;
+        }
+        sel = -1;
+    }
+}
+
+void dim_frame(const uint8_t* frame, uint32_t pitch) {
+    g_dim.resize(size_t(kW) * kH * 4);
+    std::vector<uint8_t> row(size_t(kW) * 4);
+    for (uint32_t y = 0; y < kH; y++) {
+        std::memcpy(row.data(), frame + size_t(y) * pitch * 4, row.size());
+        uint8_t* d = &g_dim[size_t(y) * kW * 4];
+        for (uint32_t x = 0; x < kW * 4; x += 4)
+            d[x] = uint8_t(row[x] * 2 / 5), d[x + 1] = uint8_t(row[x + 1] * 2 / 5), d[x + 2] = uint8_t(row[x + 2] * 2 / 5),
+            d[x + 3] = 255;
+    }
+}
+
+bool load_fonts() {
+    return load_font(g_text, "/app0/boot/menu_font.bin") && load_font(g_title, "/app0/boot/font.bin");
+}
+
+}  // namespace
+
+void settings_load(bool cross_confirms) {
+    g_cross = cross_confirms;
+    default_map(g_set.map);
+    const char* h = std::getenv("NX_HANDHELD");
+    const char* r = std::getenv("NX_RENDER_RES");
+    if (h && h[0] == '1') {
+        g_set.res = kResCount - 1;
+    } else if (r) {
+        for (int k = 0; k < kResCount - 1; k++)
+            if (std::strcmp(kResolutions[k].value, r) == 0) g_set.res = k;
+    }
+    const char* f = std::getenv("NX_FSR");
+    g_set.fsr = !f || f[0] == '1';
+    if (const char* s = std::getenv("NX_FSR_SHARP")) g_set.sharp = std::clamp(float(std::atof(s)), 0.0f, 2.0f);
+    if (const char* c = std::getenv("NX_PS4_CORES"))
+        for (int k = 0; k < 3; k++)
+            if (std::strcmp(kCores[k], c) == 0) g_set.cores = k;
+    if (const char* c = std::getenv("NX_PS4_FPS")) g_set.counter = std::clamp(std::atoi(c), 0, 2);
+    if (const char* m = std::getenv("NX_PS4_MAP")) parse_map(m, g_set.map);
+    publish();
+}
+
+uint32_t settings_ds4_for(int b) { return b >= 0 && b < kNxCount ? g_map_bits[b].load(std::memory_order_relaxed) : 0; }
+bool settings_fsr() { return g_fsr.load(std::memory_order_relaxed); }
+float settings_fsr_sharpness() { return g_sharp.load(std::memory_order_relaxed); }
+int settings_frame_counter() { return g_counter.load(std::memory_order_relaxed); }
+
+void counter_label(uint8_t* rgba, uint32_t w, uint32_t h, double fps, double ms) {
+    Canvas cv{rgba, int(w), int(h)};
+    cv.rect(0, 0, int(w), int(h), kPanel, 255);
+    cv.rect(0, 0, 4, int(h), kGold, 255);
+    if (!load_fonts()) return;
+    char line[48];
+    if (g_counter == 2)
+        std::snprintf(line, sizeof line, "%.0f FPS  %.1f ms", fps, ms);
+    else
+        std::snprintf(line, sizeof line, "%.0f FPS", fps);
+    text(cv, line, 16, (int(h) - int(g_text.cell_h)) / 2, kWhite, false);
+}
+
+void menu_request() {
+    if (!g_open) g_request = true;
+}
+bool menu_requested() { return g_request.load(); }
+
+bool menu_blocks_input(uint32_t ds4_buttons) {
+    if (g_open) return true;
+    if (g_hold_after) {  // after the menu: nothing until every button is up (no stray A press into the game)
+        if (ds4_buttons) return true;
+        g_hold_after = false;
+    }
+    return false;
+}
+
+#if !defined(SMW_MENU_PREVIEW)
+void menu_run(const uint8_t* frame, uint32_t pitch, int video, int game_buffer, int64_t flip_arg) {
+    g_request = false;
+    uint8_t* bufs[2] = {boot_buffer(0), boot_buffer(1)};
+    if (!bufs[0] || !bufs[1] || !load_fonts()) {
+        log("menu: no boot screen buffers or fonts: no menu");
+        return;
+    }
+    g_open = true;
+    log("menu: open");
+    dim_frame(frame, pitch);  // read once: the swapchain image is write-combined too
+    bool full[2] = {false, false};
+    MenuState m;
+    Input in;
+    uint32_t b = 0;
+    uint8_t ly = 128;
+    menu_pad(b, ly);
+    step(in, b, ly);  // the L3 + R3 that opened the menu: held, not pressed
+    int k = 0;
+    while (!m.done) {
+        b = 0, ly = 128;
+        menu_pad(b, ly);
+        step(in, b, ly);
+        std::string title, footer;
+        std::vector<Row> rows;
+        int sel = 0;
+        menu_frame(m, in, title, rows, footer, sel);
+        publish();  // FSR, the frame counter and the mapping take effect at once
+        draw_panel(title, rows, sel, footer, m.note);
+        if (!full[k]) {  // this buffer's first frame: the whole dimmed picture
+            for (uint32_t y = 0; y < kH; y++)
+                std::memcpy(bufs[k] + size_t(y) * kW * 4, &g_dim[size_t(y) * kW * 4], size_t(kW) * 4);
+            full[k] = true;
+        }
+        for (int y = 0; y < kPh; y++)
+            std::memcpy(bufs[k] + (size_t(kPy + y) * kW + kPx) * 4, &g_panel[size_t(y) * kPw * 4], size_t(kPw) * 4);
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);  // write-combined stores out before the flip
+        sceVideoOutSubmitFlip(video, boot_buffer_index(k), ORBIS_VIDEO_OUT_FLIP_VSYNC, flip_arg);
+        k ^= 1;
+        std::this_thread::sleep_for(std::chrono::milliseconds(33));  // the other buffer is off screen by then
+    }
+    publish();
+    save();
+    if (m.diag) request_diag();
+    if (m.restart) {
+        log("menu: restarting the game");
+        const char* args[] = {nullptr};
+        sceSystemServiceLoadExec("/app0/eboot.bin", args);
+    }
+    sceVideoOutSubmitFlip(video, game_buffer, ORBIS_VIDEO_OUT_FLIP_VSYNC, flip_arg);
+    g_hold_after = true;
+    g_open = false;
+    log("menu: closed");
+}
+#else
+// The PC preview: page `page` with `sel` selected over `frame` (or grey), written to `out` as a PPM.
+void menu_preview(const char* fonts, const uint8_t* frame, int page, int sel, const char* out) {
+    std::string dir = fonts;
+    load_font(g_text, (dir + "/menu_font.bin").c_str());
+    load_font(g_title, (dir + "/font.bin").c_str());
+    default_map(g_set.map);
+    std::vector<uint8_t> grey(size_t(kW) * kH * 4, 90);
+    dim_frame(frame ? frame : grey.data(), kW);
+    MenuState m;
+    m.page = page == 0 ? Page::Main : page == 1 ? Page::Controls : Page::Bind;
+    m.sel = m.ctl_sel = sel;
+    Input in;
+    std::string title, footer;
+    std::vector<Row> rows;
+    int s = 0;
+    menu_frame(m, in, title, rows, footer, s);
+    draw_panel(title, rows, s, footer, m.note);
+    std::vector<uint8_t> img = g_dim;
+    for (int y = 0; y < kPh; y++)
+        std::memcpy(&img[(size_t(kPy + y) * kW + kPx) * 4], &g_panel[size_t(y) * kPw * 4], size_t(kPw) * 4);
+    std::vector<uint8_t> label(340 * 56 * 4);
+    g_counter = 2;
+    counter_label(label.data(), 340, 56, 29.97, 33.4);
+    for (int y = 0; y < 56; y++) std::memcpy(&img[(size_t(24 + y) * kW + kW - 364) * 4], &label[size_t(y) * 340 * 4], 340 * 4);
+    FILE* f = std::fopen(out, "wb");
+    std::fprintf(f, "P6\n%u %u\n255\n", kW, kH);
+    for (size_t i = 0; i < img.size(); i += 4) std::fwrite(&img[i], 1, 3, f);
+    std::fclose(f);
+}
+#endif
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_menu.h b/runtime/src/ps4/ps4_menu.h
new file mode 100644
index 0000000..85636e9
--- /dev/null
+++ b/runtime/src/ps4/ps4_menu.h
@@ -0,0 +1,44 @@
+// PS4 quick menu (ps4_menu.cpp): hold L3 + R3 in game for the settings an emulator would offer. The game pauses while
+// it is open; the menu draws over a dimmed copy of the last frame on the boot screen's two VideoOut buffers.
+//   Live: upscaling (FSR 1 or a plain stretch), FSR sharpness, a frame counter, the button mapping, a storyboard
+//   capture.
+//   At the next start (the menu can restart the game): render resolution (FSR 1 quality modes), handheld mode, CPU
+//   core layout.
+// Settings are kept in /data/SMW/config.txt as NX_<KEY>=<value> lines, read at startup like the rest of that file.
+#pragma once
+
+#include <cstdint>
+
+namespace nx::plat::ps4 {
+
+// The Switch buttons the menu maps to DualShock 4 buttons (the D-pad and sticks stay where they are).
+enum NxButton { kNxA, kNxB, kNxX, kNxY, kNxL, kNxR, kNxZL, kNxZR, kNxPlus, kNxMinus, kNxLS, kNxRS, kNxCount };
+
+// After config.txt became the environment (main): the settings from NX_RENDER_RES, NX_HANDHELD, NX_FSR,
+// NX_FSR_SHARP, NX_PS4_CORES and NX_PS4_MAP. `cross_confirms`: the default mapping puts A on Cross.
+void settings_load(bool cross_confirms);
+
+// The DualShock 4 button bits (ORBIS_PAD_BUTTON_*) mapped to Switch button `b`: 0 for none.
+uint32_t settings_ds4_for(int b);
+bool settings_fsr();
+float settings_fsr_sharpness();
+int settings_frame_counter();  // 0 off, 1 FPS, 2 FPS and frame time (NX_PS4_FPS)
+// The frame counter's label (ps4_vk_wsi.cpp copies it into each frame's top right corner): w x h RGBA, opaque.
+void counter_label(uint8_t* rgba, uint32_t w, uint32_t h, double fps, double ms);
+
+// The input thread (platform_ps4.cpp): L3 + R3 held asks for the menu; while it is open (and until every button is
+// released after it) the game reads no buttons.
+void menu_request();
+bool menu_requested();
+bool menu_blocks_input(uint32_t ds4_buttons);
+
+// The presenting thread (ps4_vk_wsi.cpp), after the frame's flip and with the GPU idle: runs the menu until it is
+// closed. `frame`: the picture on screen (linear RGBA, `pitch` pixels a row). The game's buffer `game_buffer` is
+// flipped back on screen (flip argument `flip_arg`) before it returns.
+void menu_run(const uint8_t* frame, uint32_t pitch, int video, int game_buffer, int64_t flip_arg);
+
+// The boot screen's buffers (ps4_boot_screen.cpp), which the menu draws on: null when they were not made.
+uint8_t* boot_buffer(int k);
+int boot_buffer_index(int k);
+
+}  // namespace nx::plat::ps4
diff --git a/runtime/src/ps4/ps4_vk_wsi.cpp b/runtime/src/ps4/ps4_vk_wsi.cpp
new file mode 100644
index 0000000..34ed41c
--- /dev/null
+++ b/runtime/src/ps4/ps4_vk_wsi.cpp
@@ -0,0 +1,645 @@
+// PS4: Vulkan window system integration on VideoOut (Resonance's ps4_wsi.cpp, from Crema's PS4WSI.cpp, as M33's
+// PS4VulkanWSI.cpp).
+//
+// RADV (DolphinPS4's GNM port) is linked into the executable and has no WSI. This file adds VK_EXT_headless_surface
+// and VK_KHR_swapchain on top of it the way DolphinPS4 presents: the swapchain images are linear R8G8B8A8 images in
+// host-visible memory (GPU address = CPU address on the PS4), registered as VideoOut buffers, and presenting queues a
+// VideoOut flip behind the GPU work submitted so far (ac_ps4_submit_flip in the Mesa winsys). The NVN layer
+// (nvn_vk.cpp) keeps using the standard surface/swapchain API through vk_get_instance_proc_addr().
+//
+// Semaphores: there is one in-order queue, and on the PS4 a submit that waits for or signals a binary semaphore with
+// no other work loses the device (Crema, Resonance). Every vkQueueSubmit goes through here without its semaphores;
+// the image the frame renders into is off screen when vkAcquireNextImageKHR returns (it waits for the flip that
+// replaced it), and the flip runs on the GPU behind the frame's commands.
+#include "ps4_vk_wsi.h"
+#include "ps4_boot_screen.h"
+#include "ps4_menu.h"
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <orbis/SystemService.h>
+#include <orbis/VideoOut.h>
+#include <orbis/libkernel.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <initializer_list>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+#include <nx/runtime.h>
+
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char* name);
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_common_GetDeviceProcAddr(VkDevice device, const char* name);
+// port/mesa/ac_ps4_drm.c: queues a VideoOut flip behind the submitted GPU work (GPU-side flip)
+extern "C" int ac_ps4_submit_flip(int video, unsigned buffer, unsigned mode, int64_t arg);
+
+namespace nx::plat::ps4 {
+
+namespace {
+
+constexpr uint32_t kMaxImages = 4;
+constexpr VkDeviceSize kFramebufferAlign = 2 << 20;  // VideoOut buffer alignment
+
+struct Surface {
+    uint32_t magic = 0x50533453;
+};
+
+struct Swapchain {
+    VkDevice device;
+    uint32_t image_count;
+    VkImage images[kMaxImages]{};
+    VkDeviceMemory memory[kMaxImages]{};
+    int buffer_set = -1;
+    int first_buffer = 0;
+    uint32_t next_image = 0;
+    uint32_t flip_mode = ORBIS_VIDEO_OUT_FLIP_VSYNC;
+    uint8_t* pixels[kMaxImages]{};  // CPU addresses (the quick menu reads the frame on screen)
+    uint32_t pitch = 0;
+};
+
+VkInstance g_instance = VK_NULL_HANDLE;
+VkPhysicalDevice g_physical = VK_NULL_HANDLE;
+VkDevice g_device = VK_NULL_HANDLE;
+int g_video = -1;  // video_out() (ps4_boot_screen.cpp): the boot screen shows on it first
+OrbisKernelEqueue* g_flip_queue = nullptr;
+std::atomic<uint64_t> g_flips{0};
+int g_next_first_buffer = 0;
+std::mutex g_lock;
+
+template <typename T>
+T device_fn(VkDevice device, const char* name) {
+    return reinterpret_cast<T>(vk_common_GetDeviceProcAddr(device, name));
+}
+
+template <typename T>
+T instance_fn(const char* name) {
+    return reinterpret_cast<T>(vk_icdGetInstanceProcAddr(g_instance, name));
+}
+
+bool open_video_out() {
+    g_video = video_out();
+    g_flip_queue = static_cast<OrbisKernelEqueue*>(video_out_flip_queue());
+    return g_video >= 0;
+}
+
+// Appends extensions to an enumeration result (count/properties two-call idiom).
+VkResult append_extensions(std::vector<VkExtensionProperties>& list,
+                           std::initializer_list<std::pair<const char*, uint32_t>> extra, uint32_t* count,
+                           VkExtensionProperties* props) {
+    for (const auto& [name, spec] : extra) {
+        VkExtensionProperties p{};
+        std::strncpy(p.extensionName, name, VK_MAX_EXTENSION_NAME_SIZE - 1);
+        p.specVersion = spec;
+        list.push_back(p);
+    }
+    if (!props) {
+        *count = uint32_t(list.size());
+        return VK_SUCCESS;
+    }
+    uint32_t n = std::min<uint32_t>(*count, uint32_t(list.size()));
+    std::memcpy(props, list.data(), n * sizeof(VkExtensionProperties));
+    *count = n;
+    return n < list.size() ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+std::vector<const char*> without(uint32_t count, const char* const* names, std::initializer_list<const char*> drop) {
+    std::vector<const char*> out;
+    for (uint32_t k = 0; k < count; k++)
+        if (std::none_of(drop.begin(), drop.end(), [&](const char* d) { return std::strcmp(names[k], d) == 0; }))
+            out.push_back(names[k]);
+    return out;
+}
+
+// ---- instance level -------------------------------------------------------------------------------------------
+
+VKAPI_ATTR VkResult VKAPI_CALL EnumerateInstanceExtensionProperties(const char* layer, uint32_t* count,
+                                                                    VkExtensionProperties* props) {
+    auto real = reinterpret_cast<PFN_vkEnumerateInstanceExtensionProperties>(
+        vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties"));
+    uint32_t n = 0;
+    real(layer, &n, nullptr);
+    std::vector<VkExtensionProperties> list(n);
+    real(layer, &n, list.data());
+    list.resize(n);
+    return append_extensions(list, {{VK_KHR_SURFACE_EXTENSION_NAME, 25}, {VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME, 1}},
+                             count, props);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL CreateInstance(const VkInstanceCreateInfo* info, const VkAllocationCallbacks* alloc,
+                                              VkInstance* instance) {
+    auto real = reinterpret_cast<PFN_vkCreateInstance>(vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkCreateInstance"));
+    VkInstanceCreateInfo copy = *info;
+    auto names = without(info->enabledExtensionCount, info->ppEnabledExtensionNames,
+                         {VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME});
+    copy.enabledExtensionCount = uint32_t(names.size());
+    copy.ppEnabledExtensionNames = names.data();
+    VkResult r = real(&copy, alloc, instance);
+    if (r == VK_SUCCESS) g_instance = *instance;
+    return r;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL EnumerateDeviceExtensionProperties(VkPhysicalDevice physical, const char* layer,
+                                                                  uint32_t* count, VkExtensionProperties* props) {
+    auto real = instance_fn<PFN_vkEnumerateDeviceExtensionProperties>("vkEnumerateDeviceExtensionProperties");
+    uint32_t n = 0;
+    real(physical, layer, &n, nullptr);
+    std::vector<VkExtensionProperties> list(n);
+    real(physical, layer, &n, list.data());
+    list.resize(n);
+    return append_extensions(list, {{VK_KHR_SWAPCHAIN_EXTENSION_NAME, 70}}, count, props);
+}
